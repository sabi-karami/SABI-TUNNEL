<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>SabiTunnel</AssemblyName>
    <RootNamespace>TT</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Version>3.1.0</Version>
    <!-- CI passes -p:SabiBuild=<run number>; the app updates itself to a higher build from the panel feed. 0 = local build, no updates. -->
    <SabiBuild Condition="'$(SabiBuild)' == ''">0</SabiBuild>
    <FileVersion>$(Version).$(SabiBuild)</FileVersion>
    <Product>SABI TUNNEL</Product>
    <AssemblyTitle>SABI TUNNEL</AssemblyTitle>
    <Company>sabi-karami</Company>
    <Copyright>TrustTunnel client: Apache-2.0, AdGuard. SABI TUNNEL app: sabi-karami</Copyright>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <DebugType>none</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="SabiBuild" Value="$(SabiBuild)" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="fonts/*.ttf" LogicalName="fonts.%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Security" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
  </ItemGroup>
</Project>
